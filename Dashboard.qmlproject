import QmlProject

Project {
    mainFile: "qml/main.qml"
    mainUiFile: "qml/main.qml"
    qt6Project: true

    QmlFiles {
        directory: "qml"
    }

    JavaScriptFiles {
        directory: "qml"
    }

    ImageFiles {
        directory: "assets"
    }

    Files {
        filter: "*.svg;*.otf;*.ttf;*.qgltf;*.bin;*.pro;*.qrc;*.md"
        directory: "assets"
    }

    Files {
        filter: "qmldir"
        directory: "qml"
    }

    Environment {
        QT_AUTO_SCREEN_SCALE_FACTOR: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    importPaths: [ "qml", "qml/components", "qml/pages" ]
    targetDirectory: "/opt/Dashboard"
}
